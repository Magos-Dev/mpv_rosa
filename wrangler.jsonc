{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Next.js rodando como Cloudflare Worker via OpenNext (Etapa 7A)
	"name": "rosaerose-pedidos",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Reduz o tamanho do Worker e acelera a inicialização
	"minify": true,
	// Plano Workers Paid: até 30 s de CPU por requisição (no gratuito seriam 10 ms)
	"limits": {
		"cpu_ms": 30000
	},
	// Variáveis PÚBLICAS (as mesmas embutidas no navegador). Segredos: wrangler secret put
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://rjqjichlkboharrmdyux.supabase.co",
		"NEXT_PUBLIC_SITE_URL": "https://pedidos.rosaerose.afweb.com.br",
		// Web Push (7E): chave pública VAPID. A privada: wrangler secret put VAPID_PRIVATE_KEY
		"NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BLVpc6tumuq3v-FFqtCaVM05PKeIwxPbcYj6y7PdMoTMzQLE7sBBZ9x2caHF2pXlKVQzmB1EcjnxT_ibDutgKo8"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Autorreferência exigida pelo OpenNext (o nome deve ser igual ao do worker)
			"binding": "WORKER_SELF_REFERENCE",
			"service": "rosaerose-pedidos"
		}
	],
	"routes": [
		{ "pattern": "pedidos.rosaerose.afweb.com.br", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
	// Segredos (NÃO ficam neste arquivo): wrangler secret put SUPABASE_SERVICE_ROLE_KEY
}
