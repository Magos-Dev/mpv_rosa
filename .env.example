# Copie para .env.local e preencha. NUNCA versione .env.local.

# --- Públicas (vão para o navegador) ---------------------------------
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://rjqjichlkboharrmdyux.supabase.co
# Chave publicável (sb_publishable_...) ou a anon key legada
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secretas (somente servidor) -------------------------------------
# Service role / secret key: ignora RLS. Nunca usar em código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Senha dos usuários de teste criados por `npm run seed:users` (mín. 8 caracteres)
SEED_USERS_PASSWORD=
